<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="Arquitectura del chat universitario" id="Arquitectura_AzChat">
    <mxGraphModel dx="1000" dy="870" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="870">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="Arquitectura del chat universitario&#10;El servidor media entre los estudiantes, sus datos y los servicios de apoyo." style="text;html=0;align=left;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="12" width="940" height="64" />
        </mxCell>
        <mxCell id="edge0" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="a" target="s">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" value="SQL sobre TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="s" target="db">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="s" target="mail">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a" value="Navegadores de estudiantes&#10;HTML, CSS y JavaScript.&#10;Formularios, historial y adjuntos.&#10;Página y API del mismo origen." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="115" width="410" height="140" />
        </mxCell>
        <mxCell id="s" value="Servidor en Render&#10;Node.js + Express.&#10;Sesión y autorización por operación.&#10;HTTP periódico para sincronizar.&#10;Rutas de mensajes y archivos." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="555" y="115" width="410" height="165" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL en Supabase&#10;Esquema privado azchat_complete.&#10;Cuentas, chats, mensajes y binarios.&#10;Sesiones y recuperación." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="555" y="410" width="410" height="150" />
        </mxCell>
        <mxCell id="mail" value="Correo y servicio Web Push&#10;Código o solicitud de autorización.&#10;Aviso de un mensaje ya guardado.&#10;La lectura sigue siendo otro paso." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="410" width="410" height="150" />
        </mxCell>
        <mxCell id="docs" value="Portal de planificación · GitHub Pages&#10;Documentación HTML, PDF y bocetos. El botón Abrir chat lleva a la aplicación." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="690" width="930" height="100" />
        </mxCell>
        <mxCell id="note" value="El navegador no se conecta directamente a PostgreSQL. El portal estático no ejecuta el chat." style="text;html=0;align=left;fontSize=16;" vertex="1" parent="1">
