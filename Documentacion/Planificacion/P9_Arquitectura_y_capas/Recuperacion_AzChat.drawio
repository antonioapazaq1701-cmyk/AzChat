<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="Recuperación del acceso de un estudiante" id="Recuperacion_AzChat">
    <mxGraphModel dx="1000" dy="1060" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1060">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="Recuperación del acceso de un estudiante&#10;Aprobar un correo nuevo y demostrar su posesión son comprobaciones distintas." style="text;html=0;align=left;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="12" width="940" height="64" />
        </mxCell>
        <mxCell id="edge0" value="Coincide" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="start" target="known">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" value="No coincide" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="start" target="new">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="Solicitar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="known" target="code">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="Aprobada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="new" target="code">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" value="Verificado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="code" target="save">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="start" value="Identificar cuenta y correo&#10;Revisar datos y confirmar la solicitud.&#10;Vincularla al navegador solicitante." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="105" width="440" height="115" />
        </mxCell>
        <mxCell id="known" value="Correo ya vinculado&#10;Si coincide con el correo confirmado,&#10;la solicitud permite pedir el código.&#10;No exige revisión administrativa." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="330" width="410" height="140" />
        </mxCell>
        <mxCell id="new" value="Correo nuevo o no coincidente&#10;Estado pendiente; avisar al responsable.&#10;Revisar identidad y previsualizar.&#10;Confirmar aprobación o rechazo." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="555" y="330" width="410" height="140" />
        </mxCell>
        <mxCell id="code" value="Probar posesión del correo&#10;Enviar y validar un código de un uso.&#10;La aprobación sola no cambia la clave.&#10;Un código inválido impide continuar." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="585" width="440" height="140" />
        </mxCell>
        <mxCell id="save" value="Confirmar nueva contraseña&#10;Guardar hash y correo confirmado.&#10;Consumir solicitud y códigos.&#10;Revocar sesiones y avisos anteriores." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="820" width="440" height="145" />
        </mxCell>
        <mxCell id="note" value="Rechazo, vencimiento o cambio de la cuenta impiden continuar. Las vigencias están en P5." style="text;html=0;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="996" width="940" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
