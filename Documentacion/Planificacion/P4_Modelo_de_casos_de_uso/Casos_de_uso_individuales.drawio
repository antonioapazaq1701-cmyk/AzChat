<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" compressed="false"><diagram id="CU-01" name="CU-01 Registrarse"><mxGraphModel page="1" pageWidth="1000" pageHeight="678" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona visitante" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="s0" value="1. Completar los datos de registro" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Validar formato y disponibilidad" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Confirmar el registro" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Crear la cuenta y solicitar ingreso" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Si los datos son inválidos o están duplicados, explicar el error y permitir corregirlos. El correo opcional deberá verificarse antes de vincularlo." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="116" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-02" name="CU-02 Iniciar sesión"><mxGraphModel page="1" pageWidth="1000" pageHeight="656" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona registrada" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="s0" value="1. Indicar usuario o código y contraseña" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Comprobar las credenciales" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Abrir una sesión autorizada" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Acceder a sus conversaciones" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Si las credenciales no coinciden, informar el rechazo sin abrir una sesión." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="94" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-03" name="CU-03 Iniciar chat privado"><mxGraphModel page="1" pageWidth="1000" pageHeight="656" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona registrada" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="s0" value="1. Buscar a la otra persona" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Mostrar coincidencias autorizadas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Seleccionar al destinatario" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Abrir el chat existente o crear uno por pareja" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Si no hay coincidencias, permitir otra búsqueda. No crear una conversación consigo mismo." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="94" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-04" name="CU-04 Consultar conversaciones"><mxGraphModel page="1" pageWidth="1000" pageHeight="656" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona registrada" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="s0" value="1. Abrir su lista de conversaciones" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Consultar los chats a los que pertenece" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Elegir una conversación" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Mostrar su historial y estado de lectura" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Si no tiene conversaciones, ofrecer iniciar una. No mostrar chats de otras cuentas." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="94" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-05" name="CU-05 Enviar mensaje"><mxGraphModel page="1" pageWidth="1000" pageHeight="678" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona emisora" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="339.3333333333333" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor2" value="Persona destinataria" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="672.6666666666666" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="s0" value="1. Preparar el contenido y pulsar Enviar" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Comprobar sesión, pertenencia y contenido" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Guardar el mensaje y confirmar" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Consultar las novedades y ver el mensaje" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="693.3333333333333" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Si falla el envío, conservar el pendiente durante la sesión de página. Reintentar con el mismo identificador para evitar duplicados." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="116" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-06" name="CU-06 Recibir mensajes"><mxGraphModel page="1" pageWidth="1000" pageHeight="774" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona destinataria" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="339.3333333333333" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor2" value="Persona emisora" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="672.6666666666666" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="s0" value="1. Enviar un mensaje a la conversación" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="693.3333333333333" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Guardar el mensaje para sus participantes" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Abrir o mantener visible la conversación" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Entregar las novedades al consultarlas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="438" width="280" height="70" /></mxCell><mxCell id="e4" edge="1" parent="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="5. Leer el contenido recibido" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="534" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Si la persona está desconectada, deberá poder recuperar los mensajes al volver. Un aviso no equivale a lectura." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="640" width="964" height="116" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-07" name="CU-07 Consultar historial"><mxGraphModel page="1" pageWidth="1000" pageHeight="656" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona registrada" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="s0" value="1. Abrir una conversación propia" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Comprobar la pertenencia y cargar una página" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Solicitar mensajes anteriores o buscar texto" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Devolver los resultados del mismo chat" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Sin pertenencia no se entregará el historial. Si no hay resultados, mostrar un estado vacío comprensible." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="94" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-08" name="CU-08 Cerrar sesión"><mxGraphModel page="1" pageWidth="1000" pageHeight="656" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona registrada" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="s0" value="1. Seleccionar Cerrar sesión" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Invalidar el acceso de ese navegador" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Retirar los avisos asociados a esa sesión" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Volver a la pantalla de ingreso" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Las conversaciones y mensajes deberán conservarse. Una sesión vencida también requerirá un nuevo ingreso." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="94" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-09" name="CU-09 Recuperar contraseña con correo vinculado"><mxGraphModel page="1" pageWidth="1000" pageHeight="1062" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona solicitante" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="339.3333333333333" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor2" value="Servicio de correo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="672.6666666666666" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="s0" value="1. Indicar la cuenta y su correo ya verificado" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Revisar los datos y confirmar la solicitud" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Solicitar la entrega de un código" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Entregar el código al correo vinculado" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="693.3333333333333" y="438" width="280" height="70" /></mxCell><mxCell id="e4" edge="1" parent="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="5. Introducir el código recibido" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="534" width="280" height="70" /></mxCell><mxCell id="e5" edge="1" parent="1" source="s4" target="s5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s5" value="6. Validar el código y habilitar el cambio" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="630" width="280" height="70" /></mxCell><mxCell id="e6" edge="1" parent="1" source="s5" target="s6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s6" value="7. Escribir y confirmar la nueva contraseña" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="726" width="280" height="70" /></mxCell><mxCell id="e7" edge="1" parent="1" source="s6" target="s7" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s7" value="8. Guardar el cambio e invalidar sesiones anteriores" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="822" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Un código incorrecto, vencido o consumido no habilitará el cambio. No se requerirá autorización administrativa para el correo ya vinculado." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="928" width="964" height="116" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-10" name="CU-10 Recuperar contraseña sin correo vinculado"><mxGraphModel page="1" pageWidth="1000" pageHeight="1254" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona solicitante" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="238.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="256.0" y="58" width="238.0" height="52" /></mxCell><mxCell id="actor2" value="Responsable" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="238.0" height="52" /></mxCell><mxCell id="actor3" value="Servicio de correo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="756.0" y="58" width="238.0" height="52" /></mxCell><mxCell id="s0" value="1. Proponer un correo y confirmar la solicitud" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="12.0" y="150" width="226.0" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Registrar la solicitud como pendiente" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="262.0" y="246" width="226.0" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Entregar la solicitud al responsable" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="762.0" y="342" width="226.0" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Comprobar identidad y previsualizar los datos" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="512.0" y="438" width="226.0" height="70" /></mxCell><mxCell id="e4" edge="1" parent="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="5. Revisar la aprobación y confirmarla de nuevo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="512.0" y="534" width="226.0" height="70" /></mxCell><mxCell id="e5" edge="1" parent="1" source="s4" target="s5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s5" value="6. Autorizar la verificación del correo propuesto" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="262.0" y="630" width="226.0" height="70" /></mxCell><mxCell id="e6" edge="1" parent="1" source="s5" target="s6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s6" value="7. Solicitar el código de verificación" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="12.0" y="726" width="226.0" height="70" /></mxCell><mxCell id="e7" edge="1" parent="1" source="s6" target="s7" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s7" value="8. Entregar el código al correo propuesto" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="762.0" y="822" width="226.0" height="70" /></mxCell><mxCell id="e8" edge="1" parent="1" source="s7" target="s8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s8" value="9. Introducir el código y confirmar una nueva clave" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="12.0" y="918" width="226.0" height="70" /></mxCell><mxCell id="e9" edge="1" parent="1" source="s8" target="s9" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s9" value="10. Validar, vincular el correo y guardar el cambio" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="262.0" y="1014" width="226.0" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Rechazar o dejar vencer la solicitud impedirá continuar. Sin código válido o sin acceso al correo no se completará el cambio. Aprobar no cambiará por sí solo la contraseña." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="1120" width="964" height="116" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-11" name="CU-11 Compartir una entrega"><mxGraphModel page="1" pageWidth="1000" pageHeight="774" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona emisora" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="339.3333333333333" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor2" value="Participante del chat" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="672.6666666666666" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="s0" value="1. Seleccionar un archivo o imagen" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Revisar la previsualización y confirmar" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Validar permisos y límites del adjunto" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Guardar el contenido y asociarlo al mensaje" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="438" width="280" height="70" /></mxCell><mxCell id="e4" edge="1" parent="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="5. Abrir el archivo desde la conversación" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="693.3333333333333" y="534" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Cancelar la previsualización no deberá enviar contenido. Rechazar archivos fuera del tamaño o cantidad permitidos." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="640" width="964" height="116" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-12" name="CU-12 Administrar un grupo"><mxGraphModel page="1" pageWidth="1000" pageHeight="774" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Administrador del grupo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="339.3333333333333" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="actor2" value="Participante" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="672.6666666666666" y="58" width="321.3333333333333" height="52" /></mxCell><mxCell id="s0" value="1. Seleccionar una acción de administración" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Comprobar su rol en ese grupo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Revisar y confirmar los cambios" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="26.666666666666657" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Actualizar los datos o la pertenencia" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="360.0" y="438" width="280" height="70" /></mxCell><mxCell id="e4" edge="1" parent="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="5. Consultar el grupo con los permisos resultantes" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="693.3333333333333" y="534" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;No aceptar cambios de una persona sin permiso. Antes de salir, deberá quedar otro administrador si permanecen participantes." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="640" width="964" height="116" /></mxCell></root></mxGraphModel></diagram><diagram id="CU-13" name="CU-13 Asignar un nombre privado"><mxGraphModel page="1" pageWidth="1000" pageHeight="678" grid="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="actor0" value="Persona propietaria" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="6.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="actor1" value="Sistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="506.0" y="58" width="488.0" height="52" /></mxCell><mxCell id="s0" value="1. Abrir la información del contacto" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="150" width="280" height="70" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="2. Escribir un nombre solo para sí misma" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="246" width="280" height="70" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="3. Validar y guardar la relación propietario-contacto" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="342" width="280" height="70" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;strokeColor=#476780;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="4. Ver el nombre elegido en su propia cuenta" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f9fc;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="110.0" y="438" width="280" height="70" /></mxCell><mxCell id="alternativas" value="Alternativas y controles&#10;Dejar el campo vacío restaurará el nombre del perfil. No modificar el perfil original ni la vista de otras personas." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf4fa;strokeColor=#a7b8c6;fontFamily=Arial;fontSize=17;fontColor=#243b50;" vertex="1" parent="1"><mxGeometry as="geometry" x="18" y="544" width="964" height="116" /></mxCell></root></mxGraphModel></diagram></mxfile>