  <diagram name="Datos del intercambio entre estudiantes" id="Modelo_datos_AzChat">
    <mxGraphModel dx="1000" dy="760" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="760">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="Datos del intercambio entre estudiantes&#10;PK: clave primaria. FK: referencia a otra tabla. UQ: combinación única." style="text;html=0;align=left;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="12" width="940" height="64" />
        </mxCell>
        <mxCell id="edge0" value="1 a N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="u" target="mem">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" value="1 a N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="con" target="mem">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="1 a N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="con" target="msg">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="1 a N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="msg" target="ma">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" value="0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#375d7b;" edge="1" parent="1" source="file" target="ma">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="u" value="usuarios&#10;PK id; UQ usuario y código.&#10;hash_contrasena, perfil.&#10;ajustes, correo confirmado.&#10;foto_id → archivos." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="110" width="290" height="175" />
        </mxCell>
        <mxCell id="mem" value="miembros&#10;PK (conversación, usuario).&#10;FK a ambas tablas.&#10;rol, ultimo_leido.&#10;fijado, silenciado." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="355" y="110" width="290" height="175" />
        </mxCell>
        <mxCell id="con" value="conversaciones&#10;PK id; tipo y creador.&#10;pareja UQ para privados.&#10;nombre, descripción y foto.&#10;FK creador → usuarios." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="110" width="290" height="175" />
        </mxCell>
        <mxCell id="msg" value="mensajes&#10;PK id; FK chat y emisor.&#10;UQ (emisor_id, id_envio).&#10;texto y respuesta_id.&#10;editado, eliminado y fechas.&#10;respuesta_id → mensajes." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="430" width="290" height="200" />
        </mxCell>
        <mxCell id="ma" value="mensaje_archivos&#10;PK (mensaje, archivo).&#10;FK a ambas tablas.&#10;archivo_id también es UQ.&#10;Un archivo se vincula&#10;a un único mensaje." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="355" y="430" width="290" height="200" />
        </mxCell>
        <mxCell id="file" value="archivos&#10;PK id UUID; FK propietario.&#10;FK conversación opcional.&#10;contenido bytea y tamaño.&#10;mime, nombre y clase.&#10;Foto o adjunto." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=14;fontSize=17;fillColor=#f5f9fc;strokeColor=#6a8ba6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="430" width="290" height="200" />
        </mxCell>
        <mxCell id="note" value="Relaciones principales de 6 tablas. El diccionario detalla autoría, fotos y respuestas a otros mensajes.&#10;Las 5 tablas de acceso, preferencias privadas y recuperación se muestran en la figura siguiente." style="text;html=0;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="696" width="940" height="60" />
        </mxCell>
      </root>
